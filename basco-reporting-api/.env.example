# ===========================================================================
# .env.example — BASCO Intelligence Portal API
# ===========================================================================
# Copy this file to .env and fill in every value before running the server.
#
#   cp .env.example .env
#
# NEVER commit .env to version control. It is listed in .gitignore.
# ===========================================================================

# ---------------------------------------------------------------------------
# Auth database — Django manages this DB (migrations, sessions, users, tokens)
# Server: Microsoft SQL Server at 20.192.13.190
# ---------------------------------------------------------------------------
AUTH_DB_SERVER=
AUTH_DB_NAME=BASCO_REPORTING_AUTH
AUTH_DB_USER=
AUTH_DB_PASS=
# AUTH_DB_PORT=1433       # optional — defaults to 1433

# ---------------------------------------------------------------------------
# Warehouse database — read-only reporting queries only, NEVER migrated
# Server: same SQL Server instance as AUTH_DB_SERVER
# ---------------------------------------------------------------------------
WAREHOUSE_DB_SERVER=
WAREHOUSE_DB_NAME=BLUE_BASCO
WAREHOUSE_DB_USER=
WAREHOUSE_DB_PASS=
# WAREHOUSE_DB_PORT=1433  # optional — defaults to 1433

# ---------------------------------------------------------------------------
# Django core
# SECRET_KEY: generate a new one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# ---------------------------------------------------------------------------
SECRET_KEY=
DEBUG=True
# ALLOWED_HOSTS is only required in production (production.py reads this)
# Example: ALLOWED_HOSTS=api.basco.com,bascointelligence.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# CORS — comma-separated list of frontend origins allowed to call the API
# Example: CORS_ALLOWED_ORIGINS=http://localhost:5173,https://app.basco.com
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# JWT token lifetimes
# ACCESS_TOKEN_LIFETIME_MINUTES: how long an access token is valid (short-lived)
# REFRESH_TOKEN_LIFETIME_DAYS:   how long a refresh token is valid (longer-lived)
# ---------------------------------------------------------------------------
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7
